# Zoho Mail SMTP Configuration (Production / Local)
#
# Zoho Mail SMTP Host options:
# US / Global: smtppro.zoho.com (or smtp.zoho.com)
# EU: smtppro.zoho.eu
# India: smtppro.zoho.in
# Australia: smtppro.zoho.com.au
#
# Port options:
# 465 (SSL - SMTP_SECURE=true) [Recommended]
# 587 (TLS - SMTP_SECURE=false)
#
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@sempliqo.tech
SMTP_PASSWORD=your_zoho_app_password_here

# Optional: override endpoint for local frontend testing if needed (defaults to /api/contact)
# VITE_CONTACT_ENDPOINT=/api/contact
